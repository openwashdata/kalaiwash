Package: kalaiwash
Title: Household Water Insecurity and Drinking Water Service Levels from the KALAI Project in Nampula, Mozambique
Version: 0.1.0
Authors@R: c(
    person("John", "Brogan", , "john.brogan.pro@gmail.com", role = "aut"),
    person("Adriana", "Clavijo Daza", , "aclavijo@ethz.ch", role = "cre",
           comment = c(ORCID = "0009-0002-0589-2274")),
    person("Dercio", "Obra", role = "aut")
